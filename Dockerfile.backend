FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /backend-app ./cmd/backend/main.go

FROM alpine:latest
WORKDIR /app
COPY --from=builder /backend-app /app/backend
COPY --from=builder /app/configs /app/configs
CMD ["/app/backend"]